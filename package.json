		"fluent-ffmpeg": "^2.1.3"
	},
	"devDependencies": {
		"@electron-toolkit/eslint-config": "^1.0.2",
		"@electron-toolkit/eslint-config-prettier": "^2.0.0",
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"electron": "^33.3.1",
		"electron-builder": "^25.1.8",
		"electron-vite": "^2.3.0",
